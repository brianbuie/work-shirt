{
  "name": "work-shirt",
  "displayName": "Work Shirt",
  "description": "A dependable, well-worn color theme built around semantic syntax highlighting, a limited palette, and a minimalist workbench.",
  "version": "3.3.0",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "node --watch src/build.ts",
    "build": "node src/build.ts",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@brianbuie/node-kit": "^1.0.2",
    "@types/node": "^26.2.0",
    "@vscode/vsce": "^3.9.2",
    "color": "^5.0.3",
    "flat": "^6.0.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "icon": "images/logo.jpg",
  "galleryBanner": {
    "color": "#262A31",
    "theme": "dark"
  },
  "author": {
    "name": "Brian Buie",
    "email": "brian@buie.dev"
  },
  "license": "Unlicense",
  "publisher": "brianbuie",
  "repository": {
    "type": "git",
    "url": "https://github.com/brianbuie/work-shirt.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "type": "module",
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Work Shirt",
        "uiTheme": "vs-dark",
        "path": "./themes/work-shirt-vscode.json"
      }
    ]
  }
}
