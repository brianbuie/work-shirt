{
  "name": "work-shirt",
  "displayName": "Work Shirt",
  "description": "A comfortable, dependable, and well-worn color theme.",
  "version": "3.0.0",
  "icon": "images/logo.jpg",
  "galleryBanner": {
    "color": "#262A31",
    "theme": "dark"
  },
  "author": {
    "name": "Brian Buie",
    "email": "brian@buie.dev"
  },
  "license": "Unlicense",
  "publisher": "brianbuie",
  "repository": {
    "type": "git",
    "url": "https://github.com/brianbuie/work-shirt.git"
  },
  "bugs": {
    "url": "https://github.com/brianbuie/work-shirt/issues",
    "email": "brian@buie.dev"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "type": "module",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Work Shirt",
        "uiTheme": "vs-dark",
        "path": "./themes/work-shirt-vscode.json"
      }
    ]
  },
  "scripts": {
    "dev": "node --watch-path=./src --watch-path=./scripts scripts/build.js",
    "build": "node scripts/build.js",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "color": "^5.0.3",
    "flat": "^6.0.1",
    "ovsx": "^0.10.6",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@10.34.5"
}
